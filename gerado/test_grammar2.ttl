@prefix ex: <http://example.org/grammar#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:Grammar a owl:Class .
ex:NonTerminal a owl:Class .
ex:Terminal a owl:Class .
ex:Production a owl:Class .
ex:Conflict a owl:Class .

ex:S a ex:Grammar ; rdfs:label "Grammar" .
ex:T_e a ex:Terminal ; rdfs:label "ε" .
ex:T_b a ex:Terminal ; rdfs:label "b" .
ex:T_a a ex:Terminal ; rdfs:label "a" .
ex:NT_S a ex:NonTerminal ; rdfs:label "S" .
ex:S ex:hasNonTerminal ex:NT_S .
ex:NT_S ex:firstSet "a,b,ε" .
ex:NT_S ex:followSet "$" .
ex:NT_B a ex:NonTerminal ; rdfs:label "B" .
ex:S ex:hasNonTerminal ex:NT_B .
ex:NT_B ex:firstSet "b,ε" .
ex:NT_B ex:followSet "$" .
ex:NT_A a ex:NonTerminal ; rdfs:label "A" .
ex:S ex:hasNonTerminal ex:NT_A .
ex:NT_A ex:firstSet "a,ε" .
ex:NT_A ex:followSet "$,b" .
ex:P_S_prod_0 a ex:Production ; ex:lhs ex:NT_S ; rdfs:label "A B" .
ex:S ex:hasProduction ex:P_S_prod_0 .
ex:P_S_prod_0 ex:hasRHSNonTerminal ex:NT_A .
ex:P_S_prod_0 ex:hasRHSNonTerminal ex:NT_B .
ex:P_A_prod_0 a ex:Production ; ex:lhs ex:NT_A ; rdfs:label "a" .
ex:S ex:hasProduction ex:P_A_prod_0 .
ex:P_A_prod_0 ex:hasRHSTerminal ex:T_a .
ex:P_A_prod_1 a ex:Production ; ex:lhs ex:NT_A ; rdfs:label "ε" .
ex:S ex:hasProduction ex:P_A_prod_1 .
ex:P_A_prod_1 ex:hasRHSTerminal ex:T_e .
ex:P_B_prod_0 a ex:Production ; ex:lhs ex:NT_B ; rdfs:label "b" .
ex:S ex:hasProduction ex:P_B_prod_0 .
ex:P_B_prod_0 ex:hasRHSTerminal ex:T_b .
ex:P_B_prod_1 a ex:Production ; ex:lhs ex:NT_B ; rdfs:label "ε" .
ex:S ex:hasProduction ex:P_B_prod_1 .
ex:P_B_prod_1 ex:hasRHSTerminal ex:T_e .