@prefix ex: <http://example.org/grammar#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Conflict a owl:Class .

ex:S a ex:Grammar ;
    rdfs:label "Grammar" ;
    ex:hasNonTerminal ex:NT_S,
        ex:NT_S_F ;
    ex:hasProduction ex:S_F_prod_0,
        ex:S_F_prod_1,
        ex:S_prod_0 .

ex:T_epsilon a ex:Terminal ;
    rdfs:label "ε" .

ex:Grammar a owl:Class .

ex:S_F_prod_0 a ex:Production ;
    rdfs:label "1" ;
    ex:hasRHSTerminal ex:T_1 ;
    ex:lhs ex:NT_S_F .

ex:S_F_prod_1 a ex:Production ;
    rdfs:label "2" ;
    ex:hasRHSTerminal ex:T_2 ;
    ex:lhs ex:NT_S_F .

ex:S_prod_0 a ex:Production ;
    rdfs:label "A S_F" ;
    ex:hasRHSNonTerminal ex:NT_S_F ;
    ex:hasRHSTerminal ex:T_A ;
    ex:lhs ex:NT_S .

ex:T_1 a ex:Terminal ;
    rdfs:label "1" .

ex:T_2 a ex:Terminal ;
    rdfs:label "2" .

ex:T_A a ex:Terminal ;
    rdfs:label "A" .

ex:NT_S a ex:NonTerminal ;
    rdfs:label "S" ;
    ex:firstSet "A" ;
    ex:followSet "$" .

ex:NonTerminal a owl:Class .

ex:Production a owl:Class .

ex:NT_S_F a ex:NonTerminal ;
    rdfs:label "S_F" ;
    ex:firstSet "1,2" ;
    ex:followSet "$" .

ex:Terminal a owl:Class .

