@prefix ex: <http://example.org/grammar#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Conflict a owl:Class .

ex:Lista a ex:Grammar ;
    rdfs:label "Grammar" ;
    ex:hasNonTerminal ex:NT_Cont,
        ex:NT_Elem,
        ex:NT_Elems,
        ex:NT_Lista,
        ex:NT_Resto,
        ex:NT_int,
        ex:NT_string ;
    ex:hasProduction ex:Cont_prod_0,
        ex:Cont_prod_1,
        ex:Elem_prod_0,
        ex:Elem_prod_1,
        ex:Elems_prod_0,
        ex:Lista_prod_0,
        ex:Resto_prod_0,
        ex:Resto_prod_1,
        ex:int_prod_0,
        ex:string_prod_0 .

ex:Cont_prod_0 a ex:Production ;
    rdfs:label "]" ;
    ex:hasRHSTerminal ex:T_square_close ;
    ex:lhs ex:NT_Cont .

ex:Cont_prod_1 a ex:Production ;
    rdfs:label "Elems ]" ;
    ex:hasRHSNonTerminal ex:NT_Elems ;
    ex:hasRHSTerminal ex:T_square_close ;
    ex:lhs ex:NT_Cont .

ex:Elem_prod_0 a ex:Production ;
    rdfs:label "int" ;
    ex:hasRHSNonTerminal ex:NT_int ;
    ex:lhs ex:NT_Elem .

ex:Elem_prod_1 a ex:Production ;
    rdfs:label "string" ;
    ex:hasRHSNonTerminal ex:NT_string ;
    ex:lhs ex:NT_Elem .

ex:Elems_prod_0 a ex:Production ;
    rdfs:label "Elem Resto" ;
    ex:hasRHSNonTerminal ex:NT_Elem,
        ex:NT_Resto ;
    ex:lhs ex:NT_Elems .

ex:Grammar a owl:Class .

ex:Lista_prod_0 a ex:Production ;
    rdfs:label "[ Cont" ;
    ex:hasRHSNonTerminal ex:NT_Cont ;
    ex:hasRHSTerminal ex:T_square_open ;
    ex:lhs ex:NT_Lista .

ex:Resto_prod_0 a ex:Production ;
    rdfs:label "ε" ;
    ex:hasRHSTerminal ex:T_epsilon ;
    ex:lhs ex:NT_Resto .

ex:Resto_prod_1 a ex:Production ;
    rdfs:label ", Elem Resto" ;
    ex:hasRHSNonTerminal ex:NT_Elem,
        ex:NT_Resto ;
    ex:hasRHSTerminal ex:T_comma ;
    ex:lhs ex:NT_Resto .

ex:T_comma a ex:Terminal ;
    rdfs:label "," .

ex:T_epsilon a ex:Terminal ;
    rdfs:label "ε" .

ex:T_square_open a ex:Terminal ;
    rdfs:label "[" .

ex:T_square_open0minus9square_closeplus a ex:Terminal ;
    rdfs:label "[0-9]+" .

ex:T_square_opencaretangle_openangle_closesquare_closeplus a ex:Terminal ;
    rdfs:label "[^<>]+" .

ex:int_prod_0 a ex:Production ;
    rdfs:label "[0-9]+" ;
    ex:hasRHSTerminal ex:T_square_open0minus9square_closeplus ;
    ex:lhs ex:NT_int .

ex:string_prod_0 a ex:Production ;
    rdfs:label "[^<>]+" ;
    ex:hasRHSTerminal ex:T_square_opencaretangle_openangle_closesquare_closeplus ;
    ex:lhs ex:NT_string .

ex:NT_Lista a ex:NonTerminal ;
    rdfs:label "Lista" ;
    ex:firstSet "[" ;
    ex:followSet "$" .

ex:T_square_close a ex:Terminal ;
    rdfs:label "]" .

ex:NT_Elems a ex:NonTerminal ;
    rdfs:label "Elems" ;
    ex:firstSet "[0-9]+,[^<>]+" ;
    ex:followSet "]" .

ex:NT_int a ex:NonTerminal ;
    rdfs:label "int" ;
    ex:firstSet "[0-9]+" ;
    ex:followSet ",,]" .

ex:NT_string a ex:NonTerminal ;
    rdfs:label "string" ;
    ex:firstSet "[^<>]+" ;
    ex:followSet ",,]" .

ex:NT_Cont a ex:NonTerminal ;
    rdfs:label "Cont" ;
    ex:firstSet "[0-9]+,[^<>]+,]" ;
    ex:followSet "$" .

ex:NT_Elem a ex:NonTerminal ;
    rdfs:label "Elem" ;
    ex:firstSet "[0-9]+,[^<>]+" ;
    ex:followSet ",,]" .

ex:NT_Resto a ex:NonTerminal ;
    rdfs:label "Resto" ;
    ex:firstSet ",,ε" ;
    ex:followSet "]" .

ex:Terminal a owl:Class .

ex:NonTerminal a owl:Class .

ex:Production a owl:Class .

