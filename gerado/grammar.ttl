@prefix ex: <http://example.org/grammar#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Conflict a owl:Class .

ex:Sexp a ex:Grammar ;
    rdfs:label "Grammar" ;
    ex:hasNonTerminal ex:NT_Exp,
        ex:NT_Funcao,
        ex:NT_INT,
        ex:NT_Lista,
        ex:NT_Lista_P,
        ex:NT_Sexp ;
    ex:hasProduction ex:Exp_prod_0,
        ex:Exp_prod_1,
        ex:Funcao_prod_0,
        ex:Funcao_prod_1,
        ex:INT_prod_0,
        ex:Lista_P_prod_0,
        ex:Lista_P_prod_1,
        ex:Lista_prod_0,
        ex:Sexp_prod_0 .

ex:Exp_prod_0 a ex:Production ;
    rdfs:label "INT" ;
    ex:hasRHSNonTerminal ex:NT_INT ;
    ex:lhs ex:NT_Exp .

ex:Exp_prod_1 a ex:Production ;
    rdfs:label "( Funcao )" ;
    ex:hasRHSNonTerminal ex:NT_Funcao ;
    ex:hasRHSTerminal ex:T_bracket_close,
        ex:T_bracket_open ;
    ex:lhs ex:NT_Exp .

ex:Funcao_prod_0 a ex:Production ;
    rdfs:label "+ Lista" ;
    ex:hasRHSNonTerminal ex:NT_Lista ;
    ex:hasRHSTerminal ex:T_plus ;
    ex:lhs ex:NT_Funcao .

ex:Funcao_prod_1 a ex:Production ;
    rdfs:label "* Lista" ;
    ex:hasRHSNonTerminal ex:NT_Lista ;
    ex:hasRHSTerminal ex:T_star ;
    ex:lhs ex:NT_Funcao .

ex:Grammar a owl:Class .

ex:INT_prod_0 a ex:Production ;
    rdfs:label "[0-9]+" ;
    ex:hasRHSTerminal ex:T_square_open0minus9square_closeplus ;
    ex:lhs ex:NT_INT .

ex:Lista_P_prod_0 a ex:Production ;
    rdfs:label "Exp Lista_P" ;
    ex:hasRHSNonTerminal ex:NT_Exp,
        ex:NT_Lista_P ;
    ex:lhs ex:NT_Lista_P .

ex:Lista_P_prod_1 a ex:Production ;
    rdfs:label "ε" ;
    ex:hasRHSTerminal ex:T_epsilon ;
    ex:lhs ex:NT_Lista_P .

ex:Lista_prod_0 a ex:Production ;
    rdfs:label "Lista_P" ;
    ex:hasRHSNonTerminal ex:NT_Lista_P ;
    ex:lhs ex:NT_Lista .

ex:Sexp_prod_0 a ex:Production ;
    rdfs:label "Exp ." ;
    ex:hasRHSNonTerminal ex:NT_Exp ;
    ex:hasRHSTerminal ex:T_dot ;
    ex:lhs ex:NT_Sexp .

ex:T_bracket_close a ex:Terminal ;
    rdfs:label ")" .

ex:T_bracket_open a ex:Terminal ;
    rdfs:label "(" .

ex:T_dot a ex:Terminal ;
    rdfs:label "." .

ex:T_epsilon a ex:Terminal ;
    rdfs:label "ε" .

ex:T_plus a ex:Terminal ;
    rdfs:label "+" .

ex:T_square_open0minus9square_closeplus a ex:Terminal ;
    rdfs:label "[0-9]+" .

ex:T_star a ex:Terminal ;
    rdfs:label "*" .

ex:NT_Sexp a ex:NonTerminal ;
    rdfs:label "Sexp" ;
    ex:firstSet "(,[0-9]+" ;
    ex:followSet "$" .

ex:NT_INT a ex:NonTerminal ;
    rdfs:label "INT" ;
    ex:firstSet "[0-9]+" ;
    ex:followSet "(,),.,[0-9]+" .

ex:NT_Funcao a ex:NonTerminal ;
    rdfs:label "Funcao" ;
    ex:firstSet "*,+" ;
    ex:followSet ")" .

ex:NT_Lista a ex:NonTerminal ;
    rdfs:label "Lista" ;
    ex:firstSet "(,[0-9]+,ε" ;
    ex:followSet ")" .

ex:NT_Exp a ex:NonTerminal ;
    rdfs:label "Exp" ;
    ex:firstSet "(,[0-9]+" ;
    ex:followSet "(,),.,[0-9]+" .

ex:NT_Lista_P a ex:NonTerminal ;
    rdfs:label "Lista_P" ;
    ex:firstSet "(,[0-9]+,ε" ;
    ex:followSet ")" .

ex:NonTerminal a owl:Class .

ex:Terminal a owl:Class .

ex:Production a owl:Class .

