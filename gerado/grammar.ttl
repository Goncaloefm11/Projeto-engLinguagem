@prefix ex: <http://example.org/grammar#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

ex:Grammar a owl:Class .
ex:NonTerminal a owl:Class .
ex:Terminal a owl:Class .
ex:Production a owl:Class .
ex:Conflict a owl:Class .

ex:Lista a ex:Grammar ; rdfs:label "Grammar" .
ex:T_eps a ex:Terminal ; rdfs:label "ε" .
ex:T_sym a ex:Terminal ; rdfs:label "[" .
ex:T_sym a ex:Terminal ; rdfs:label "," .
ex:T_sym a ex:Terminal ; rdfs:label "[^<>]+" .
ex:T_0-9 a ex:Terminal ; rdfs:label "[0-9]+" .
ex:T_sym a ex:Terminal ; rdfs:label "]" .
ex:NT_Resto a ex:NonTerminal ; rdfs:label "Resto" .
ex:Lista ex:hasNonTerminal ex:NT_Resto .
ex:NT_Resto ex:firstSet ",,ε" .
ex:NT_Resto ex:followSet "]" .
ex:NT_Elem a ex:NonTerminal ; rdfs:label "Elem" .
ex:Lista ex:hasNonTerminal ex:NT_Elem .
ex:NT_Elem ex:firstSet "[0-9]+,[^<>]+" .
ex:NT_Elem ex:followSet ",,]" .
ex:NT_string a ex:NonTerminal ; rdfs:label "string" .
ex:Lista ex:hasNonTerminal ex:NT_string .
ex:NT_string ex:firstSet "[^<>]+" .
ex:NT_string ex:followSet ",,]" .
ex:NT_Lista a ex:NonTerminal ; rdfs:label "Lista" .
ex:Lista ex:hasNonTerminal ex:NT_Lista .
ex:NT_Lista ex:firstSet "[" .
ex:NT_Lista ex:followSet "$" .
ex:NT_Cont a ex:NonTerminal ; rdfs:label "Cont" .
ex:Lista ex:hasNonTerminal ex:NT_Cont .
ex:NT_Cont ex:firstSet "[0-9]+,[^<>]+,]" .
ex:NT_Cont ex:followSet "$" .
ex:NT_Elems a ex:NonTerminal ; rdfs:label "Elems" .
ex:Lista ex:hasNonTerminal ex:NT_Elems .
ex:NT_Elems ex:firstSet "[0-9]+,[^<>]+" .
ex:NT_Elems ex:followSet "]" .
ex:NT_int a ex:NonTerminal ; rdfs:label "int" .
ex:Lista ex:hasNonTerminal ex:NT_int .
ex:NT_int ex:firstSet "[0-9]+" .
ex:NT_int ex:followSet ",,]" .
ex:P_Lista_prod_0 a ex:Production ; ex:lhs ex:NT_Lista ; rdfs:label "[ Cont" .
ex:Lista ex:hasProduction ex:P_Lista_prod_0 .
ex:P_Lista_prod_0 ex:hasRHSTerminal ex:T_sym .
ex:P_Lista_prod_0 ex:hasRHSNonTerminal ex:NT_Cont .
ex:P_Cont_prod_0 a ex:Production ; ex:lhs ex:NT_Cont ; rdfs:label "]" .
ex:Lista ex:hasProduction ex:P_Cont_prod_0 .
ex:P_Cont_prod_0 ex:hasRHSTerminal ex:T_sym .
ex:P_Cont_prod_1 a ex:Production ; ex:lhs ex:NT_Cont ; rdfs:label "Elems ]" .
ex:Lista ex:hasProduction ex:P_Cont_prod_1 .
ex:P_Cont_prod_1 ex:hasRHSNonTerminal ex:NT_Elems .
ex:P_Cont_prod_1 ex:hasRHSTerminal ex:T_sym .
ex:P_Elems_prod_0 a ex:Production ; ex:lhs ex:NT_Elems ; rdfs:label "Elem Resto" .
ex:Lista ex:hasProduction ex:P_Elems_prod_0 .
ex:P_Elems_prod_0 ex:hasRHSNonTerminal ex:NT_Elem .
ex:P_Elems_prod_0 ex:hasRHSNonTerminal ex:NT_Resto .
ex:P_Resto_prod_0 a ex:Production ; ex:lhs ex:NT_Resto ; rdfs:label "ε" .
ex:Lista ex:hasProduction ex:P_Resto_prod_0 .
ex:P_Resto_prod_0 ex:hasRHSTerminal ex:T_eps .
ex:P_Resto_prod_1 a ex:Production ; ex:lhs ex:NT_Resto ; rdfs:label ", Elem Resto" .
ex:Lista ex:hasProduction ex:P_Resto_prod_1 .
ex:P_Resto_prod_1 ex:hasRHSTerminal ex:T_sym .
ex:P_Resto_prod_1 ex:hasRHSNonTerminal ex:NT_Elem .
ex:P_Resto_prod_1 ex:hasRHSNonTerminal ex:NT_Resto .
ex:P_Elem_prod_0 a ex:Production ; ex:lhs ex:NT_Elem ; rdfs:label "int" .
ex:Lista ex:hasProduction ex:P_Elem_prod_0 .
ex:P_Elem_prod_0 ex:hasRHSNonTerminal ex:NT_int .
ex:P_Elem_prod_1 a ex:Production ; ex:lhs ex:NT_Elem ; rdfs:label "string" .
ex:Lista ex:hasProduction ex:P_Elem_prod_1 .
ex:P_Elem_prod_1 ex:hasRHSNonTerminal ex:NT_string .
ex:P_int_prod_0 a ex:Production ; ex:lhs ex:NT_int ; rdfs:label "[0-9]+" .
ex:Lista ex:hasProduction ex:P_int_prod_0 .
ex:P_int_prod_0 ex:hasRHSTerminal ex:T_0-9 .
ex:P_string_prod_0 a ex:Production ; ex:lhs ex:NT_string ; rdfs:label "[^<>]+" .
ex:Lista ex:hasProduction ex:P_string_prod_0 .
ex:P_string_prod_0 ex:hasRHSTerminal ex:T_sym .